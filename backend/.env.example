[TEMPLATE]
# --- SERVER -----------------------------------------------------------------
# Port the server listens on. macOS reserves port 5000 for AirPlay Receiver,
# so we use 5001 by default. Override with PORT env var for deployment.
PORT=5001

# --- AUTH -------------------------------------------------------------------
# Secret used to sign JWT login tokens. MUST be changed to a long random string
# before deploying publicly. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string

# Admin login credentials for the /admin dashboard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- CORS -------------------------------------------------------------------
# URL of your deployed frontend for production. Use * for local development.
CORS_ORIGIN=*
